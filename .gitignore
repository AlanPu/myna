# Python
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# Downloaded source audio and rendered player assets.
# Everything here is produced by rebuild.py; committing 60MB+ of derived
# media would make the history unusable for no benefit.
audio2/
player/*.m4a
player/*.webm
player/slow/
player/shots/

# Both of these describe ONE video — the one currently built — and every
# rebuild overwrites them in place, so they are a snapshot of local state
# rather than a source of truth. Swapping videos rewrote ~2000 lines apiece,
# which made the diff for an unrelated one-line fix unreadable.
#
# They are NOT inputs anyone can check out and rely on: no clone is guaranteed
# to hold whatever video the last contributor happened to build. check.py and
# the verify_*.py scripts do read them, so a fresh clone must run rebuild.py
# once (which fetches the audio, writes both files and runs the checks) before
# any check can run. That is the price of keeping the repository free of
# per-video state, and rebuild.py is already the documented entry point.
player/player_captions.json
player/energy.json

# Local tooling state. .workbuddy/ holds the assistant's own session notes for
# this working copy — per-machine, per-session, and of no use to anyone who
# clones the repository. Same class as .vscode/ or .idea/.
.workbuddy/

# macOS
.DS_Store
